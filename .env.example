# ============================================
# Reader Hub — Environment Variables
# Copy this file to .env and fill in your values
# ============================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Cloudflare R2 ---
CF_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=reader-hub-data
R2_PUBLIC_DOMAIN=your-r2-public-domain.r2.dev

# --- Proxy (for scraping) ---
PROXY_URL=http://user:pass@proxy-host:port

# --- GitHub (for Edge Function → Actions trigger) ---
GITHUB_PAT=ghp_your-personal-access-token
GITHUB_OWNER=your-github-username
GITHUB_REPO=reader-hub
